# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.

# --- SEC EDGAR ---------------------------------------------------------------
# SEC REQUIRES a descriptive User-Agent identifying your application and a
# contact email, per https://www.sec.gov/os/webmaster-faq#developers
# Requests without a proper User-Agent may be throttled or blocked.
# Format: "AppName/version (contact@example.com)"
# NOTE: replace the example email with a real contact address you control.
SEC_USER_AGENT=MarketIntelligence/0.1 (you@example.com)

# --- FRED (Federal Reserve Economic Data) ------------------------------------
# Free API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Application -------------------------------------------------------------
# Absolute path to the data/logs home. Leave blank to use the project root
# (the directory containing pyproject.toml).
MARKET_INTELLIGENCE_HOME=

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
