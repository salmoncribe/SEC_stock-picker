# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets.

# --- SEC EDGAR ---------------------------------------------------------------
# SEC REQUIRES a descriptive User-Agent identifying your application and a
# contact email, per https://www.sec.gov/os/webmaster-faq#developers
# Requests without a proper User-Agent may be throttled or blocked.
# Format: "AppName/version (contact@example.com)"
# NOTE: replace the example email with a real contact address you control.
SEC_USER_AGENT=MarketIntelligence/0.1 (you@example.com)

# --- FRED (Federal Reserve Economic Data) ------------------------------------
# Free API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Application -------------------------------------------------------------
# Absolute path to the data/logs home. Leave blank to use the project root
# (the directory containing pyproject.toml).
#
# Point this at external storage before collecting at scale: a full filing-
# document ingestion over the S&P 500 universe runs to tens of GB, and the
# price history alone is ~2.7 GB. Everything (raw/, normalized/, parquet/, the
# DuckDB file, and logs/) moves with it, so relocating is one variable.
#
# To move an existing tree: rsync it across, verify with
# `rsync -an --checksum` (0 files transferred means byte-identical), set this,
# confirm `market-intelligence status` reports the new home, and only then
# remove the original. Keeping both copies is worse than either one alone --
# if this variable is ever unset, collection silently resumes into the stale
# project-root tree instead of failing.
MARKET_INTELLIGENCE_HOME=

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Autopilot notifications (optional) --------------------------------------
# The daily briefing is pushed to Telegram. Leave blank to skip the nudge; the
# Obsidian note is still written either way.
# Reuse an existing bot token or create one with @BotFather. TELEGRAM_CHAT_ID is
# the destination: your own user id (message @userinfobot to find it), or a
# group/channel id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
