#!/bin/zsh
# Open the local Market Intelligence dashboard from anywhere on this Mac.
set -euo pipefail

ROOT="$(cd "$(dirname "${0:A}")" && pwd)"
PORT="${PAGE_PORT:-8765}"
LOG="$ROOT/logs/page.log"
URL="http://127.0.0.1:$PORT"

(
  cd "$ROOT"
  uv run python -m market_intelligence.dashboard --refresh-only
) || true

if ! curl --silent --fail --max-time 1 "$URL/api/snapshot" >/dev/null 2>&1; then
  mkdir -p "$ROOT/logs"
  (
    cd "$ROOT"
    exec nohup uv run python -m market_intelligence.dashboard --port "$PORT"
  ) >>"$LOG" 2>&1 < /dev/null &
  for _ in {1..30}; do
    curl --silent --fail --max-time 1 "$URL/api/snapshot" >/dev/null 2>&1 && break
    sleep 0.1
  done
fi

open "$URL"
echo "Market Intelligence dashboard: $URL"
