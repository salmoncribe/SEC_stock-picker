<?xml version="1.0" encoding="UTF-8"?>
<!--
  Autopilot watchdog: the second, independent layer against a silent hang.

  A 2026-07 incident let `ai.quant.autopilot` hang 5+ hours a day for several
  days straight, blocking the DuckDB write lock the whole time and never
  reaching the point where it could tell Michael. `ai.quant.autopilot.plist`
  now wraps the real command in `gtimeout` so a hang gets SIGTERM'd after 120
  minutes instead of running for hours -- but a `timeout` wrapper is one
  mechanism, not a guarantee. This watchdog runs on its own schedule, checks
  from outside the pipeline entirely whether today's run is alive, hung, or
  never happened at all, and is allowed to kill a hung process itself and
  page Telegram, independent of whether the gtimeout wrapper fired.

  Deliberately does NOT read the DuckDB database -- see
  scripts/watch_autopilot.py's module docstring for why polling the DB during
  a suspected hang is unreliable (the hung step holds the write lock for the
  whole hang). It relies on `pgrep`/`ps` and the Obsidian briefing note
  instead.

  Unlike ai.quant.graph-watchdog.plist (`--quiet` by convention -- that one's
  job is purely local), this watchdog's entire purpose is alerting Michael on
  Telegram, so it is never run with `--quiet` and there is no such flag.

  Install:
    cp config/launchd/ai.quant.autopilot-watchdog.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/501 ~/Library/LaunchAgents/ai.quant.autopilot-watchdog.plist
  Run once now to test:
    launchctl start ai.quant.autopilot-watchdog
  Uninstall:
    launchctl bootout gui/501/ai.quant.autopilot-watchdog
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.quant.autopilot-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/michaeltadlock/quant &amp;&amp; /opt/homebrew/bin/uv run python scripts/watch_autopilot.py</string>
    </array>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/michaeltadlock/quant/logs/autopilot-watchdog.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/michaeltadlock/quant/logs/autopilot-watchdog.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
