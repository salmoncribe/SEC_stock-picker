<?xml version="1.0" encoding="UTF-8"?>
<!--
  Relationship graph watchdog.

  Runs every three minutes while the relationship extractor is building the
  connection graph. Each pass restarts the extractor if it is missing and
  regenerates the Obsidian company-note projection from DuckDB when possible.

  Runs with --quiet: no Telegram messages (growth ping, heartbeat, failure
  ping all suppressed). Michael only wants Telegram for trade alerts; this
  agent's job is purely local (keep the extractor alive, keep the vault
  in sync). Check logs/graph-watchdog.log for status instead.

  Install:
    cp config/launchd/ai.quant.graph-watchdog.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/ai.quant.graph-watchdog.plist
  Run once now to test:
    launchctl start ai.quant.graph-watchdog
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/ai.quant.graph-watchdog.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.quant.graph-watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/michaeltadlock/quant &amp;&amp; /opt/homebrew/bin/uv run python scripts/watch_relationship_graph.py --quiet</string>
    </array>

    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/michaeltadlock/quant/logs/graph-watchdog.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/michaeltadlock/quant/logs/graph-watchdog.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
