<?xml version="1.0" encoding="UTF-8"?>
<!--
  RAM guard: a standing safety net, independent of the daily autopilot run.

  The daily loop only runs once a morning, but memory pressure can happen any
  time the connection engine's LLM (ollama) is running alongside everything
  else on this 16GB mini. This agent runs `market-intelligence ram-guard`
  every 10 minutes. On a healthy machine it does nothing and logs nothing
  worth reading; it only acts (stopping an exact duplicate of a known
  singleton process -- a second ollama server, a re-launched collector) once
  macOS itself reports low free memory. It never touches the process holding
  the DuckDB lock or this session's own ancestry.

  Install:
    cp config/launchd/ai.quant.ramguard.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/ai.quant.ramguard.plist
  Run once now to test:
    launchctl start ai.quant.ramguard
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/ai.quant.ramguard.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.quant.ramguard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/michaeltadlock/quant &amp;&amp; /opt/homebrew/bin/uv run market-intelligence ram-guard</string>
    </array>

    <key>StartInterval</key>
    <integer>600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/michaeltadlock/quant/logs/ramguard.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/michaeltadlock/quant/logs/ramguard.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
